# NODE_ENV: Set to "production" when running compiled /dist build
NODE_ENV=production

# PORT: HTTP and WebSocket server port (automatically provided on cPanel / PaaS hosts)
PORT=3000

# SESSION_SECRET: Random hex secret used to sign HMAC-SHA256 session tokens and cookies
SESSION_SECRET="replace-with-a-64-char-random-hex-secret"

# APP_URL: Public URL where the application is hosted
APP_URL="http://localhost:3000"
